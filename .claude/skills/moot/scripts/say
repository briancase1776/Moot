#!/bin/bash
##
# @file say
# @brief Land the words on stdin on the wire as a seat, once.
# @details say DIR SEAT < words. DIR is what create printed, and SEAT a
#          seat as the map spells it. What goes on is a line with the
#          length in bytes of what follows, then SEAT's mark, the words,
#          and a newline at the end if the words lack one, in one write of
#          whole pages. Nothing takes a turn: every other seat reads the
#          words on a cable of its own, and on a mesh-p p's merge takes each
#          say whole before the next, as Merge says of what one writer puts
#          on without a pause. A write that finds the wire full waits there
#          until the slowest seat reads. A body holding a line shaped like
#          the mark, SEAT and one word alone, is refused, because a reader
#          would take it for another seat's; so is a say past the BYTES the
#          moot was made for, since a read end holds one say that size from
#          each seat that writes into it and no bigger. p writes nowhere,
#          and a say from p is refused too. A refused say puts nothing on
#          the wire.
# @stdin the words
# @stdout nothing
# @stderr the reason, on refusal
# @exit 0 the words are on the wire; 1 they were refused, or the seat is
#       not in the map or writes nowhere, and nothing went on
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDir=${1:?usage: say DIR SEAT}
osSeat=${2:?usage: say DIR SEAT}
set -eu
export LC_ALL=C
source "$(dirname "$0")/.seat"
[ -n "$pWriteLane" ] || {
  echo "seat $osSeat writes nowhere in $pPatch" >&2
  exit 1
}
osWords=$(printf 'SEAT %s\n' "$osSeat"; cat; printf .)
osWords=${osWords%.}
[ "${osWords: -1}" = $'\n' ] || osWords+=$'\n'
osMark=$'\n''SEAT [^[:space:]]+'$'\n'
[[ ! $'\n'${osWords#*$'\n'} =~ $osMark ]] || {
  echo "seat $osSeat: the body has a line shaped like the mark" >&2
  exit 1
}
[ "${#osWords}" -le "$nBytes" ] || {
  echo "seat $osSeat: ${#osWords} bytes, past the $nBytes this moot holds" >&2
  exit 1
}
# dd and not printf: bash line-buffers a builtin's output, so printf puts a
# short line on as a write of its own, which takes a page of the lane to
# itself. dd writes whole pages, the last part full, one after another. The
# here-string gives back the newline the words end in.
osSaid=${#osWords}$'\n'${osWords%$'\n'}
dd bs=4096 status=none <<< "$osSaid" > "$pWriteLane"
