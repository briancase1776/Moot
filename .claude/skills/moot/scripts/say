#!/bin/bash
# .claude/skills/moot/scripts/say
# say DIR SEAT < words: land the words on the wire as SEAT, once: a line with
# their length in bytes, then the mark and the words, ending in a newline, in
# one write. Nothing takes a turn: the merge takes each say whole before the
# next, as Merge says of what one writer puts on without a pause. Past the
# BYTES the moot was made for it is refused, and nothing goes on: the read
# ends hold a round of says that size and no bigger.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
export LC_ALL=C
d=${1:?usage: say DIR SEAT}; i=${2:?usage: say DIR SEAT}
. "$(dirname "$0")/.seat"
words=$(printf 'SEAT %s\n' "$i"; cat; printf .); words=${words%.}
[ "${words: -1}" = $'\n' ] || words+=$'\n'
mark=$'\n''SEAT [^[:space:]]+'$'\n'
[[ ! $'\n'${words#*$'\n'} =~ $mark ]] ||
  { echo "seat $i: the body has a line shaped like the mark" >&2; exit 1; }
[ "${#words}" -le "$bytes" ] ||
  { echo "seat $i: ${#words} bytes, past the $bytes this moot holds" >&2; exit 1; }
# dd and not printf: bash line-buffers a builtin's output, so printf puts a
# short line on as a write of its own, which takes a page of the lane to
# itself. dd writes whole pages, the last part full, one after another. The
# here-string ends in the newline the words end in.
dd bs=4096 status=none <<< "${#words}"$'\n'"${words%$'\n'}" > "$wl"
