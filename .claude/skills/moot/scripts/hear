#!/bin/bash
##
# @file hear
# @brief Print the round at a seat, once all of it is in.
# @details hear DIR SEAT. The round is the next say from each seat that
#          writes into one of SEAT's read ends, a read end at a time, in
#          the order the map lists them: one from each other seat, or at p
#          all N off its one end from the merge, in the order the merge took
#          them. A seat's own words never come back to it. For each say it
#          reads the length line in front and copies that many bytes.
#          Anything behind the round is the next round's and stays on the
#          wire. What it copies is off the wire once it is printed, and
#          nothing keeps it, so a hear cut off partway has lost what it
#          took.
# @stdin nothing
# @stdout the round: each say's mark and words, ending in a newline
# @stderr the reason, on refusal
# @exit 0 the round is printed; 1 the seat is not in the map, or the wire
#       is out of step, as a say cut inside its write leaves it
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDir=${1:?usage: hear DIR SEAT}
osSeat=${2:?usage: hear DIR SEAT}
set -eu
export LC_ALL=C
source "$(dirname "$0")/.seat"
for oRead in "${aReads[@]}"; do
  read -r pReadLane osPeers <<< "$oRead"
  IFS=, read -r -a aPeers <<< "$osPeers"
  exec {fdLane}< "$pReadLane"
  for ((iSay = 0; iSay < ${#aPeers[@]}; iSay++)); do
    read -r -u "$fdLane" nLength
    [[ $nLength =~ ^[0-9]+$ ]] || {
      echo "seat $osSeat: the wire is out of step; the moot is over" >&2
      exit 1
    }
    head -c "$nLength" <&"$fdLane"
  done
  exec {fdLane}<&-
done
