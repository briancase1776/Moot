#!/bin/bash
# .claude/skills/moot/scripts/hear
# hear DIR SEAT: print the round, the next says on SEAT's read end in the
# order they came: read the length in front of each, copy that many bytes,
# as many times as a round has says. Anything behind them is the next
# round's and stays on the wire. What it copies is off the wire once it is
# printed, so a hear cut off partway has lost what it took.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
export LC_ALL=C
d=${1:?usage: hear DIR SEAT}; i=${2:?usage: hear DIR SEAT}
. "$(dirname "$0")/.seat"
exec {lane}< "$rl"
for ((k = 0; k < says; k++)); do
  read -r -u "$lane" len
  [[ $len =~ ^[0-9]+$ ]] ||
    { echo "seat $i: the wire is out of step; the moot is over" >&2; exit 1; }
  head -c "$len" <&"$lane"
done
