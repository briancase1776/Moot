#!/bin/sh
# .claude/skills/moot/scripts/remove
# remove DIR: remove the patch create made, then DIR. DIR is what create
# printed. If Patch's remove fails, DIR and its line stay and remove exits
# nonzero, so nothing is orphaned without a line naming it. A patch that
# is already gone is not in the way.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
set -eu
d=${1:?usage: remove DIR}
[ -f "$d/moot" ] || { echo "not a moot: $d" >&2; exit 1; }
read -r shape n x b f < "$d/moot"
[ ! -d "$x" ] || "$b/remove" "$x"
rm -rf "$d"
