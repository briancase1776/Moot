#!/bin/bash
##
# @file remove
# @brief Remove a moot: its patch, then its directory.
# @details remove DIR. DIR is what create printed and the caller holds it;
#          nothing here looks a moot up. If Patch's remove fails, DIR and
#          its line stay and remove exits nonzero, so the patch that would
#          not go is still named in the DIR the caller already has. A patch
#          that is already gone is not in the way.
# @stdin nothing
# @stdout nothing
# @stderr the reason, on refusal, and whatever Patch's remove says
# @exit 0 the moot is gone; 1 DIR is not a moot, or its patch would not
#       go and DIR is left
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDir=${1:?usage: remove DIR}
set -eu
[ -f "$pDir/moot" ] || {
  echo "not a moot: $pDir" >&2
  exit 1
}
read -r eShape nSeats pPatch nBytes pIccPatch < "$pDir/moot"
[ ! -d "$pPatch" ] || "$pIccPatch/remove" "$pPatch"
rm -rf "$pDir"
