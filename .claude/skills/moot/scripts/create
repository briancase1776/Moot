#!/bin/bash
##
# @file create
# @brief Patch a mesh for a moot, deep enough for its rounds; print the moot.
# @details create SHAPE N [BYTES]. SHAPE is mesh or mesh-p, N the seats
#          besides p, 2 or more, and BYTES the most one say may be, 1 or
#          more, and 524288 when not given, about what a model's longest
#          answer comes to; both numbers are read in base ten. Patch's
#          create makes the wire, from $ICC, by default ../ICC beside this
#          repo: two lanes, and every seat's read end pipes enough deep to
#          hold a round of N says of BYTES. A mesh 2 is one pipe, which
#          Patch does not deepen, so there BYTES is at most what one lane
#          holds. The moot's directory holds one file, moot: SHAPE, N, the
#          patch, Patch's scripts and BYTES, on one line. Patch makes the
#          wire; the moot makes nothing but its rounds. The cleanup is
#          armed before the patch is made, so a create that cannot finish,
#          or that a signal cuts off, leaves no patch: bash runs the EXIT
#          trap when it dies on one.
# @stdin nothing
# @stdout the moot's directory, one line
# @stderr the reason, on refusal, and whatever Patch's create says
# @exit 0 the moot is made and printed; 1 the arguments are refused, or
#       the patch or the directory could not be made, and none of it is
#       left
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
eShape=$1
nSeats=$2
nBytes=${3:-524288}
set -eu
[ $# -ge 2 ] || {
  echo "usage: create SHAPE N [BYTES]" >&2
  exit 1
}
case $eShape in
  mesh|mesh-p)
    ;;
  *)
    echo "shape is mesh or mesh-p" >&2
    exit 1
    ;;
esac
[ "$nSeats" -ge 2 ] 2>/dev/null || {
  echo "seats must be 2 or more" >&2
  exit 1
}
[ "$nBytes" -ge 1 ] 2>/dev/null || {
  echo "bytes must be 1 or more" >&2
  exit 1
}
# In base ten, as Patch reads them, so 02 is the mesh 2 it makes.
nSeats=$((10#$nSeats))
nBytes=$((10#$nBytes))
# A mesh 2 is one pipe, which nothing deepens: a say there is at most what
# one lane holds, 65536 bytes, less the length line in front of it.
if [ "$eShape" = mesh ] && [ "$nSeats" -eq 2 ] && [ "$nBytes" -gt 65472 ]
then
  nBytes=65472
fi
# A say is its length line, its mark and its words: a block of 4096 for
# every 4096 of that, and one more for the last, part full. A round is N of
# them, and D pipes in series hold 17 D - 1 blocks, 16 a pipe and one a
# joint.
nBlocks=$(( nSeats * ((nBytes + 64 + 4095) / 4096 + 1) ))
nDepth=$(( (nBlocks + 1 + 16) / 17 ))
pTop=$(cd "$(dirname "$0")/../../../.." && pwd)
pIcc=$(cd "${ICC:-$pTop/../ICC}" && pwd)
pIccPatch=$(cd "$pIcc/.claude/skills/icc-patch/scripts" && pwd)
# Armed before anything is made: the patch goes however this ends, until
# the moot's line names it.
pPatch=
trap '[ -z "$pPatch" ] || "$pIccPatch/remove" "$pPatch"' EXIT
pPatch=$("$pIccPatch/create" "$eShape" "$nSeats" 2 "$nDepth")
pDir=$(mktemp -d /tmp/moot-XXXXXXXX)
echo "$eShape $nSeats $pPatch $pIccPatch $nBytes" > "$pDir/moot"
trap - EXIT
echo "$pDir"
