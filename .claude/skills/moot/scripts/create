#!/bin/bash
##
# @file create
# @brief Patch a mesh for a moot, deep enough for its rounds; print the moot.
# @details create SHAPE N [BYTES]. SHAPE is mesh or mesh-p, N the seats
#          besides p, 2 or more, and BYTES the most one say may be, 1 or
#          more, and 524288 when not given, about what a model's longest
#          answer comes to; both numbers are counts, as icc-lib's nCount
#          takes one. Patch's create makes the wire, from $ICC, by default
#          ../ICC beside this repo: two lanes, every seat's read end pipes
#          enough deep to hold a say of BYTES, and p's, which Patch makes N
#          times as deep, a round of them. A mesh 2 is one pipe, which
#          Patch does not deepen, so there BYTES is at most what one lane
#          holds. The moot's directory holds one file, moot: SHAPE, N, the
#          patch, BYTES and Patch's scripts, on one line, the scripts last
#          so that read gives them the rest of it, spaces and all. Patch
#          makes the wire; the moot makes nothing but its rounds. The
#          cleanup is armed with icc-lib's vArm before anything is made,
#          so a create that cannot finish, or that a signal cuts off,
#          leaves neither the patch nor the moot's directory.
# @stdin nothing
# @stdout the moot's directory, one line, as soon as it is made, as
#         icc-lib's pMakeDir prints it
# @stderr the reason, on refusal, and whatever Patch's create says
# @exit 0 the moot is made; 1 the arguments are refused, or
#       the patch or the directory could not be made, and none of it is
#       left
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
eShape=$1
nSeats=$2
nBytes=${3:-524288}
set -eu
[ $# -ge 2 ] || {
  echo "usage: create SHAPE N [BYTES]" >&2
  exit 1
}
pTop=$(cd "$(dirname "$0")/../../../.." && pwd)
pIcc=$(cd "${ICC:-$pTop/../ICC}" && pwd)
pIccPatch=$(cd "$pIcc/.claude/skills/icc-patch/scripts" && pwd)
source "$pIcc/.claude/skills/icc-lib/scripts/lib"
case $eShape in
  mesh|mesh-p)
    ;;
  *)
    echo "shape is mesh or mesh-p" >&2
    exit 1
    ;;
esac
nSeats=$(nCount seats "$nSeats")
[ "$nSeats" -ge 2 ] || {
  echo "seats must be 2 or more" >&2
  exit 1
}
nBytes=$(nCount bytes "$nBytes")
[ "$nBytes" -ge 1 ] || {
  echo "bytes must be 1 or more" >&2
  exit 1
}
# A mesh 2 is one pipe, which nothing deepens: a say there is at most what
# one lane holds, 65536 bytes, less the length line in front of it.
if [ "$eShape" = mesh ] && [ "$nSeats" -eq 2 ] && [ "$nBytes" -gt 65472 ]
then
  nBytes=65472
fi
# A say is its length line, its mark and its words: a block of 4096 for
# every 4096 of that, the last part full, and one block of slack. A seat's
# cable from another seat carries one say a round, and D pipes in series
# hold 17 D - 1 blocks, 16 a pipe and one a joint.
nBlocks=$(( (nBytes + 64 + 4095) / 4096 + 1 ))
nDepth=$(( (nBlocks + 1 + 16) / 17 ))
# Armed before anything is made, as icc-lib's vArm says: the patch and the
# moot's directory go however this ends, until the moot is whole.
pPatch=
pDir=
vArm '[ -z "$pPatch" ] || "$pIccPatch/remove" "$pPatch" || :
      [ -z "$pDir" ] || rm -rf "$pDir"
      exit 1'
pPatch=$("$pIccPatch/create" "$eShape" "$nSeats" 2 "$nDepth")
pMakeDir moot
echo "$eShape $nSeats $pPatch $nBytes $pIccPatch" > "$pDir/moot"
vDisarm
