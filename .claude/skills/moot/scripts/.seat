# .claude/skills/moot/scripts/.seat
# Sourced by say and hear, with DIR in d and SEAT in i: find the lane SEAT
# writes and the lane it reads in the map, and how many says make a round
# at SEAT. The seat is matched as a string, so no spelling of a seat but the
# map's finds an end. A pipe here is two lanes: the side a seat holds is the
# lane it writes, and the other is the lane it reads.
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT License text omitted for brevity, See LICENCE.TXT
read -r shape n x b bytes < "$d/moot"
end() {
  awk -v s="$i" -v k="$1" '$1""==s"" && $2""==k"" {print $3, $2, $4}' "$x/patch"
}
w=$(end 0); r=$(end 1)
[ -n "$w" ] || w=$r; [ -n "$r" ] || r=$w
[ -n "$w" ] || { echo "no seat $i in $x" >&2; exit 1; }
set -- $w; wl=$1/$2; wp=$3
set -- $r; rl=$1/$((1 - $2))
# Where the seat is its own peer a tee hands its words back, and a round is
# all N says; on the one pipe of a mesh 2 its own never come back, and a
# round is the other seat's.
case ",$wp," in *,"$i",*) says=$n;; *) says=$((n - 1));; esac
