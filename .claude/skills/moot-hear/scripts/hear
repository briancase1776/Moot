#!/bin/bash
##
# @file hear
# @brief Print the round at a seat, once all of it is in.
# @details hear DIR SEAT. The round is the next say from each seat that
#          writes into one of SEAT's read ends, a read end at a time, in the
#          order the map lists them: one from each other seat, or at p all N
#          off its one end, in the order the merge took them, as Patch says
#          of the shape. The read ends come off Patch's map with icc-lib's
#          oLanes, sourced from beside Patch's scripts, which says which
#          lanes a seat writes and reads, and how a seat is matched. For
#          each say it reads the length line in front and copies that many
#          bytes. Anything behind the round is the next round's and stays on
#          the wire. Before it takes anything it waits, with icc-lib's
#          vWaitFor, until every read end has something on it; if its time
#          runs out first it says not yet, having taken nothing, and can be
#          called again. Its time is nine tenths of what Claude Code gives a
#          call, so it says so before the call is cut off: the milliseconds
#          in BASH_MAX_TIMEOUT_MS when that is a count, and 600000, Claude
#          Code's own, when not. What it copies is off the wire once it is
#          printed, and nothing keeps it, so a hear cut off while it reads
#          has lost what it took.
# @global BASH_MAX_TIMEOUT_MS - read
# @stdin nothing
# @stdout the round: each say's mark and words, ending in a newline
# @stderr the reason, on refusal; "not yet, nothing taken" when the round
#         is not in before its time runs out
# @exit 0 the round is printed; 1 the seat is not in the map, the round is
#       not in yet and nothing was taken, or the wire is out of step, as a
#       say cut inside its write leaves it
#
# Copyright (c) 2026 Brian Case. All rights reserved.
# AI contributor: Claude (Anthropic)
#
# MIT Licence. See LICENCE.TXT
##
pDir=${1:?usage: hear DIR SEAT}
osSeat=${2:?usage: hear DIR SEAT}
set -eu
export LC_ALL=C
read -r eShape nSeats pPatch nBytes pIccPatch < "$pDir/moot"
source "$pIccPatch/../../icc-lib/scripts/lib"
pWriteLane=$(oLanes "$pPatch" "$osSeat" w)
mapfile -t aReads < <(oLanes "$pPatch" "$osSeat" r)
[ -n "$pWriteLane" ] || [ "${#aReads[@]}" -gt 0 ] || {
  echo "no seat $osSeat in $pPatch" >&2
  exit 1
}
osWho="seat $osSeat"
nMs=${BASH_MAX_TIMEOUT_MS:-600000}
[[ $nMs =~ ^[0-9]{1,15}$ ]] || nMs=600000
vWaitFor "$pPatch" "$osSeat" $((10#$nMs * 9 / 10000))
for oRead in "${aReads[@]}"; do
  read -r pReadLane osPeers <<< "$oRead"
  IFS=, read -r -a aPeers <<< "$osPeers"
  exec {fdLane}< "$pReadLane"
  for ((iSay = 0; iSay < ${#aPeers[@]}; iSay++)); do
    read -r -u "$fdLane" nLength
    [[ $nLength =~ ^[0-9]+$ ]] || {
      echo "seat $osSeat: the wire is out of step; the moot is over" >&2
      exit 1
    }
    head -c "$nLength" <&"$fdLane"
  done
  exec {fdLane}<&-
done
